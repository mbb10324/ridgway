{
	"name": "primus-next",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": "^20.9.0 || >=21.1.0"
	},
	"scripts": {
		"dev": "next dev --turbopack",
		"dev-local": "scripts/run_local_dev.sh",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"format": "prettier --check --ignore-path .gitignore .",
		"format:fix": "prettier --write --ignore-path .gitignore .",
		"db:generate": "npx prisma generate",
		"db:migrate-dev": "npx prisma migrate dev",
		"db:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
		"test": "vitest",
		"coverage": "vitest run --coverage",
		"test:ci": "vitest run --coverage --reporter=junit --outputFile=junit.xml",
		"lint-and-coverage": "npm run lint && npm run coverage",
		"cypress-open": "npx wait-on tcp:127.0.0.1:3000 tcp:127.0.0.1:5432 && echo 'Starting Cypress Application...' && npx cypress open",
		"cypress-terminal": "npx wait-on tcp:127.0.0.1:3000 tcp:127.0.0.1:5432 && echo 'Starting Cypress Terminal' && npx cypress run"
	},
	"dependencies": {
		"@auth/prisma-adapter": "2.11.3",
		"@prisma/client": "^6.19.2",
		"@t3-oss/env-nextjs": "^0.13.8",
		"@t3-oss/env-nuxt": "^0.13.8",
		"@tanstack/react-query": "^5.72.0",
		"loglevel": "^1.9.2",
		"next": "^16.4.2",
		"next-auth": "5.0.0-beta.32",
		"pg": "^8.14.1",
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"react-hook-form": "^7.55.0",
		"react-icons": "^5.7.0",
		"react-toastify": "^11.0.5",
		"three": "^0.186.1",
		"zod": "^4.0.8"
	},
	"overrides": {
		"deepmerge-ts": "8.0.2",
		"effect": "3.21.0",
		"next": {
			"postcss": "^8.5.26"
		},
		"defu": "^6.1.5",
		"minimatch": "^10.2.4"
	},
	"devDependencies": {
		"@next/eslint-plugin-next": "^16.2.12",
		"@tailwindcss/postcss": "^4.1.3",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^20.14.15",
		"@types/react": "^19.2.1",
		"@types/react-dom": "^19.2.1",
		"@typescript-eslint/eslint-plugin": "^8.1.0",
		"@typescript-eslint/parser": "^8.29.0",
		"@vitejs/plugin-react": "^4.3.4",
		"@vitest/coverage-v8": "^4.1.10",
		"cypress": "^15.19.0",
		"eslint": "^9.39.5",
		"eslint-plugin-react": "^7.22.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-sonarjs": "^4.2.0",
		"jsdom": "^26.0.0",
		"postcss": "^8.5.3",
		"prettier": "^3.5.3",
		"prisma": "^6.19.2",
		"raw-loader": "^4.0.2",
		"tailwindcss": "^4.1.3",
		"ts-node": "^10.9.2",
		"typescript": "5.8.3",
		"vitest": "^4.1.10",
		"wait-on": "^8.0.3"
	},
	"allowScripts": {
		"@prisma/client@6.19.3": true,
		"@prisma/engines@6.19.3": true,
		"cypress@15.19.0": true,
		"esbuild@0.28.1": true,
		"fsevents@2.3.3": true,
		"prisma@6.19.3": true
	}
}
