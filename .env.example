# Environment
NODE_ENV="development" # Environment the application is running in
# LOG_LEVEL="debug" # Optional, set to 'trace', 'debug', 'info', 'warn', or 'error'

# Docker development container ownership. Run `id -u` and `id -g` in WSL and
# change these only when your user/group IDs are not 1000.
LOCAL_UID=1000
LOCAL_GID=1000

# Database
DATABASE_URL="postgres://postgres:postgres@localhost:5432/primus" # Postgres connection string

# Classification Markings - Only enable this variable if you have received guidance for how to classify your application
# Options are: 'Unclassified', 'Classified', 'CUI', 'Confidential', 'Secret', 'Top Secret'
